{
  "name": "ltm-email-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/hydrate-production-d1.mjs && npm run typecheck && vite build && node scripts/migrate-production-d1.mjs",
    "build:cloudflare": "npm run build",
    "preview": "npm run build && vite preview",
    "deploy": "node scripts/assert-cloudflare-production.mjs && node scripts/verify-production-d1.mjs && npm run db:migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^14.0.3",
    "postal-mime": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  }
}
